user www-data;
worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx.pid;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    server_tokens off;
    autoindex off;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;
    keepalive_timeout 15s;
    keepalive_requests 100;
    reset_timedout_connection on;
    server {
        listen 0.0.0.0:${HTTP_PORT};
        server_name _;
        root /html;
        index index.html;
        # Permit the document-root alias, but never follow links inside the public tree.
        disable_symlinks on from=$document_root;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # Baseline protection without breaking arbitrary site's scripts/styles or CDN assets.
        add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'" always;
        # HTTPS/HSTS is deliberately not forced on Evernode's plain-HTTP assigned port.
        location ~ (^|/)\. { return 404; }
        location ~* (?:~|\.(?:bak|old|orig|save|swp|swo|tmp|sql|sqlite|sqlite3|db|log|pem|key|php|phtml|phar|py|sh|bash))$ { return 404; }
        location ~* /(?:package(?:-lock)?\.json|bun\.lockb?|yarn\.lock|pnpm-lock\.yaml|Dockerfile|(?:docker-)?compose\.ya?ml)$ { return 404; }
        location / {
            limit_except GET { deny all; } # GET also permits HEAD; no writable/WebDAV methods.
            try_files $uri $uri/ =404;
        }
        location = /health {
            limit_except GET { deny all; }
            default_type text/plain;
            return 200 "ok\n";
        }
    }
}
